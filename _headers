# Cloudflare Pages. Every open must see the newest build: the page, the service worker, and the version marker are never served from a stale cache.
/
  Cache-Control: no-cache, max-age=0, must-revalidate
/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate
/version.json
  Cache-Control: no-store
/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate
/sem-docs.json
  Cache-Control: no-cache
/sem-docs-*
  Cache-Control: no-cache
# State pages are named by content hash (st/<code>.<hash>.js), so they can be cached for good
/st/*
  Cache-Control: public, max-age=31536000, immutable
# Rule text groups are named by content hash (lr/<n>.<hash>.js), so they can be cached for good, too
/lr/*
  Cache-Control: public, max-age=31536000, immutable
# Judge photos are named by content hash (ph/<hash>.webp)
/ph/*
  Cache-Control: public, max-age=31536000, immutable
